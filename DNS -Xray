{
  "hosts": {
    "dns.google": "8.8.8.8",
    "proxy.example.com": "127.0.0.1"
  },
  "servers": [
    // 新增：国外域名先走 FakeDNS
    {
      "address": "fakedns",
      "domains": [
        "geosite:google",
        "geosite:geolocation-!cn"
      ],
      "skipFallback": true
    },
    // 原国外域名 DoH 保持不变（FakeDNS 兜底）
    {
      "address": "https://dns.google/dns-query",
      "domains": [
        "geosite:google",
        "geosite:geolocation-!cn"
      ],
      "skipFallback": true
    },
    // 国内域名 → 腾讯 DoH，不受 fakedns 影响
    {
      "address": "https://doh.pub/dns-query",
      "domains": [
        "geosite:cn"
      ],
      "expectedIPs": [
        "geoip:cn"
      ],
      "skipFallback": true
    },
    // 兜底
    "https://dns.google/dns-query"
  ]
}
