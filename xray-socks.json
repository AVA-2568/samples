{
  // 日志：排障用；磁盘紧张时 access 可改为 "none" 关闭
  "log": {
    "access": "/var/log/xray/access.log",
    "error": "/var/log/xray/error.log",
    "loglevel": "warning"
  },
  "inbounds": [
    {
      "listen": "0.0.0.0", // 对外服务；仅本机使用改 "127.0.0.1"
      "port": 1080, // 必改：避开 1080 等常见扫描端口
      "protocol": "socks",
      "settings": {
        "auth": "password", // 公网必须密码认证；"noauth" 为匿名，严禁公网使用
        "users": [
          {
            "user": "your-username", // 必改
            "pass": "your-strong-password" // 必改：强随机密码
          }
        ],
        "udp": false // 需 UDP（DNS/游戏）改 true，并在同级加 "ip": "本机公网IP"（NAT 环境必须）
      },
      "tag": "socks-in"
    }
  ],
  "outbounds": [
    {
      "protocol": "freedom",
      "settings": {
        "domainStrategy": "AsIs",
        "finalRules": [
          // 防滥用：阻断回环打本机 SSH 及垃圾邮件出站端口；有需要可删此条
          { "action": "block", "port": "22,25,465,587" },
          // 安全兜底：禁止访问私有/保留地址（防探测 VPS 内网与云元数据 169.254.169.254）
          {
            "action": "block",
            "network": "tcp,udp",
            "ip": [
              "geoip:private",
              "0.0.0.0/8",
              "100.64.0.0/10",
              "169.254.0.0/16",
              "198.18.0.0/15",
              "224.0.0.0/3",
              "fc00::/7",
              "fe80::/10"
            ]
          }
        ]
      },
      "tag": "direct" // 第一个 outbound 即默认出站
    }
  ]
}
